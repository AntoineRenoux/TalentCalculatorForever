# Client API créé sur https://develop.battle.net/access/clients (client credentials).
# Copier en .env à côté de docker-compose.yml ; ne jamais commiter le vrai fichier.
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
BNET_REGION=eu

# Optionnel : webhook Discord du salon #candidatures (formulaire de recrutement).
# Vide = le formulaire passe en mode manuel (texte à copier dans Discord).
DISCORD_WEBHOOK_URL=
