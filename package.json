{
  "name": "former-hope-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Site de la guilde Former Hope : pages de guilde, calculateur de talents et armurerie WoW Forever",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "lint": "eslint . && node scripts/check-literals.mjs",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "check": "npm run lint && npm run lint:css && npm run build",
    "server:build": "tsc -p server/tsconfig.json",
    "server:dev": "tsx server/src/server.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "postcss-custom-media": "^12.0.3",
    "stylelint": "^18.0.0",
    "stylelint-declaration-strict-value": "^1.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}
